{
  "description": "Restful Booker Platform (Shady Meadows B&B). Datos para el discovery por la API publica de la app. Los datos son compartidos con todos los que usan la demo: cada receta crea datos propios, identificables por texto unico. Formato y uso en v3/scripts/lib/data-recipe.js.",
  "api": "https://automationintesting.online/api",
  "headers": {
    "Accept": "application/json"
  },
  "recipes": {
    "mensaje": {
      "description": "Consulta enviada por el formulario de contacto (sin sesion). El asunto lleva un valor unico para ubicarla entre los mensajes de otros usuarios.",
      "params": {
        "name": "Qa Contacto",
        "email": "qa.contacto@example.com",
        "phone": "01234567890",
        "description": "Quisiera saber si tienen disponibilidad para dos noches en octubre."
      },
      "vars": {
        "subject": "Consulta QA {{unique}}"
      },
      "steps": [
        {
          "method": "POST",
          "path": "/message",
          "expect": 200,
          "body": {
            "name": "{{name}}",
            "email": "{{email}}",
            "phone": "{{phone}}",
            "subject": "{{subject}}",
            "description": "{{description}}"
          }
        }
      ]
    },
    "admin": {
      "description": "Login del administrador de la demo (admin/password). El front guarda el token en la cookie \"token\".",
      "steps": [
        {
          "method": "POST",
          "path": "/auth/login",
          "expect": 200,
          "body": {
            "username": "admin",
            "password": "password"
          },
          "save": {
            "token": "token"
          }
        }
      ],
      "browser": {
        "cookies": {
          "token": "{{token}}"
        }
      }
    },
    "habitacion": {
      "description": "Habitacion creada en el panel (requiere la receta admin). El nombre lleva un valor unico para ubicarla entre las de otros usuarios; el alta no devuelve el id, se busca por el nombre.",
      "requires": ["token"],
      "params": {
        "type": "Double",
        "roomPrice": 120,
        "description": "Habitacion creada por QA."
      },
      "vars": {
        "roomName": "QA{{unique}}"
      },
      "steps": [
        {
          "method": "POST",
          "path": "/room",
          "expect": 200,
          "headers": {
            "Cookie": "token={{token}}"
          },
          "body": {
            "roomName": "{{roomName}}",
            "type": "{{type}}",
            "accessible": false,
            "roomPrice": "{{roomPrice}}",
            "features": ["WiFi"],
            "description": "{{description}}",
            "image": "/images/room2.jpg"
          }
        },
        {
          "method": "GET",
          "path": "/room",
          "expect": 200,
          "save": {
            "roomid": "rooms[roomName={{roomName}}].roomid"
          }
        }
      ]
    },
    "reserva": {
      "description": "Reserva de una habitacion para unas fechas (sin sesion, como la hace el sitio). checkin/checkout YYYY-MM-DD: usar fechas lejanas y unicas, la demo es compartida.",
      "params": {
        "roomid": 1,
        "firstname": "Qa Reserva",
        "lastname": "Tester",
        "email": "qa.reserva@example.com",
        "phone": "01234567890",
        "checkin": "2027-06-13",
        "checkout": "2027-06-15"
      },
      "steps": [
        {
          "method": "POST",
          "path": "/booking",
          "expect": 201,
          "body": {
            "roomid": "{{roomid}}",
            "firstname": "{{firstname}}",
            "lastname": "{{lastname}}",
            "depositpaid": false,
            "email": "{{email}}",
            "phone": "{{phone}}",
            "bookingdates": {
              "checkin": "{{checkin}}",
              "checkout": "{{checkout}}"
            }
          },
          "save": {
            "bookingid": "bookingid"
          }
        }
      ]
    }
  }
}
